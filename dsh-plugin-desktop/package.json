  "peerDependencies": {
    "electron": "43.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6",
    "builder-util": "26.15.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "jsdom": "29.1.1",
    "lexical": "0.49.0",
    "lucide-react": "^1.33.0",
    "node-gyp": "13.0.1",
    "react-dom": "18.3.1",
    "shadcn": "^4.18.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsdown": "0.22.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.8"
  },
  "build": {
    "appId": "com.clawclaw.desktop",
    "productName": "ClawClaw",
    "asar": false,
    "afterPack": "./scripts/verify-packaged-runtime.ts",
    "afterAllArtifactBuild": "./scripts/verify-electron-fuses.ts",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false,
      "resetAdHocDarwinSignature": true,
      "runAsNode": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "files": [
      "build/app-icon.ico",
      "build/app-icon.icns",
      "build/app-icon.png",
      "build/app-icon-mac.png",
      "build/tray-icon.svg",
      "build/tray-icon*.png",
      "cordis.patch.yml",
      "lib/**",
      "package.json",
      "!node_modules/node-pty/build/**",
      "!node_modules/fs-ext/build/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh_CN"
        ]
      },
      "hardenedRuntime": true,
      "icon": "build/app-icon.icns",
      "mergeASARs": false,
      "notarize": true,
      "signIgnore": [
        "\\.(?:pak|dat|wasm)$"
      ],
      "x64ArchFiles": "**/node_modules/{@deepseek-ai/node-addon-system-darwin-*/**,node-pty/prebuilds/darwin-*/**,fs-ext/prebuilds/darwin-*/**,node-addon-require-builtin-darwin-*/**,@vscode/ripgrep-darwin-*/**,@img/sharp-darwin-*/**,@img/sharp-libvips-darwin-*/**,@koromix/koffi-darwin-*/**}",
      "asar": false
    },
    "win": {
      "asar": false,
      "compression": "normal",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClawClaw-${version}-${arch}-Portable.${ext}",
      "icon": "build/app-icon.ico"
    },
    "nsis": {
      "include": "installer.nsh",
      "installerIcon": "build/app-icon.ico",
      "license": "THIRD_PARTY_NOTICES.md",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "shortcutName": "ClawClaw",
      "uninstallerIcon": "build/app-icon.ico",
      "useZip": false,
      "artifactName": "ClawClaw-${version}-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/app-icon.png",
      "asar": false
    },
    "npmRebuild": false
  }
}
