{
  "name": "clawclaw",
  "version": "0.1.23",
  "description": "ClawClaw - Local-first AI agent desktop application",
  "homepage": "https://clawclaw.xzinfra.com",
  "author": "ClawClaw Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "init": "pnpm install && pnpm run uv:download",
    "dev": "tauri dev",
    "package:prepare": "pnpm run build && node scripts/prepare-tauri.mjs",
    "build": "pnpm run build:backend && pnpm run build:vite",
    "build:vite": "vite build",
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "release:check": "node scripts/release-gate.mjs",
    "uv:download": "zx scripts/download-bundled-uv.mjs",
    "uv:download:mac": "zx scripts/download-bundled-uv.mjs --platform=mac",
    "uv:download:win": "zx scripts/download-bundled-uv.mjs --platform=win",
    "uv:download:linux": "zx scripts/download-bundled-uv.mjs --platform=linux",
    "python:download:win": "zx scripts/download-bundled-python.mjs --platform=win",
    "node:download:win": "zx scripts/download-bundled-node.mjs --platform=win",
    "icons": "zx scripts/generate-icons.mjs",
    "branding:apply": "node scripts/apply-branding.mjs",
    "package:mac": "pnpm run package:prepare && tauri build",
    "package:win": "pnpm run package:prepare && tauri build",
    "package:linux": "pnpm run package:prepare && tauri build",
    "dev:web": "vite --host 127.0.0.1",
    "build:backend": "node scripts/build-backend.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "^0.78.1",
    "@tauri-apps/api": "^2.8.0",
    "clawhub": "^0.5.0",
    "dompurify": "^3.3.3",
    "marked": "15.0.12",
    "ms": "^2.1.3",
    "tar": "^6.2.1",
    "undici": "^7.16.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "framer-motion": "^12.34.2",
    "globals": "^17.3.0",
    "i18next": "^25.8.11",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.563.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zustand": "^5.0.11",
    "zx": "^8.8.5"
  },
  "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268"
}
