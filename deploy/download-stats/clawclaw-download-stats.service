[Unit]
Description=Aggregate ClawClaw download logs

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/clawclaw-download-stats/download-stats.py --logs /var/log/clawclaw-downloads --state /var/lib/clawclaw-download-stats/private --output /var/lib/clawclaw-download-stats/report
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clawclaw-download-stats
