# Copy to .env.server.local (ignored by Git), then replace every <...> value.
# Existing deployments must retain their current paths to preserve state.
STATS_DEPLOY_HOST=<ssh-host>
STATS_DEPLOY_USER=<administrator>
STATS_DEPLOY_PORT=22
# Optional; otherwise use your SSH config/agent.
# STATS_DEPLOY_SSH_KEY_FILE=<absolute-private-key-path>
# STATS_DEPLOY_SSH_KNOWN_HOSTS_FILE=<absolute-known-hosts-path>
STATS_PROGRAM_DIR=<absolute-program-directory>
STATS_DATA_DIR=<absolute-data-directory>
STATS_LOG_DIR=<absolute-log-directory>
STATS_BACKUP_DIR=<absolute-backup-directory>
STATS_NGINX_CONFIG=<absolute-download-vhost-file>
STATS_ACCESS_LOG=<absolute-existing-access-log>
STATS_BIND_ADDRESS=<private-ipv4-address>
STATS_HTTP_PORT=9529
STATS_ALLOWED_CIDRS=<company-ipv4-cidr-list-separated-by-commas>

# Release publication (independent of statistics administration).
UPDATE_HOST=<release-ssh-host>
UPDATE_USER=<release-account>
UPDATE_PORT=22
UPDATE_REMOTE_ROOT=<absolute-release-root>
# Optional when rendering the standalone download-origin template.
UPDATE_TLS_CERT=<absolute-certificate-file>
UPDATE_TLS_KEY=<absolute-private-key-file>

# Installation PDF publication uses administrator access (separate from the release key).
UPDATE_SSH_ADMIN_USER=<administrator>
UPDATE_BASE_URL=https://clawclaw.xzinfra.com:9528
# DOCS_NGINX_CONFIG defaults to STATS_NGINX_CONFIG above.
# DOCS_NGINX_CONFIG=<absolute-download-vhost-file>
# Optional; defaults to STATS_DEPLOY_SSH_* or the SSH config/agent.
# DOCS_SSH_KEY_FILE=<absolute-administrator-private-key-path>
# DOCS_SSH_KNOWN_HOSTS_FILE=<absolute-known-hosts-path>
