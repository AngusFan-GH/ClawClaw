{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-runner",
    "noEmit": false,
    "declaration": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/runner/**/*.ts"]
}
