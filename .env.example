# ClawClaw environment variables

# Development
VITE_DEV_SERVER_PORT=5173

# Override the ClawCore data directory (otherwise the OS userData dir is used)
# CLAWCLAW_DATA_DIR=/path/to/data

# Model credentials are stored in the OS keychain via the secret:* native bridge,
# never in this file.

# Code signing / publishing (only needed for packaged releases)
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
# CSC_LINK=path/to/certificate.p12
# CSC_KEY_PASSWORD=certificate_password
# GH_TOKEN=github_personal_access_token
